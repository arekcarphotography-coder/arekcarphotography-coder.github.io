# Konfiguracja serwera (Hostido — LiteSpeed/Apache)
DirectoryIndex index.html
Options -Indexes
ErrorDocument 404 /404.html
AddDefaultCharset utf-8
AddType image/webp .webp
AddType image/svg+xml .svg

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Zawsze https i adres bez "www"
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
  # Polityka prywatności została usunięta (2026-11-19)
  RewriteRule ^polityka-prywatnosci/?$ / [R=301,L]
  RewriteRule ^en/privacy-policy/?$ /en/ [R=301,L]
  # Narzędzia i pliki robocze nie są publiczne
  RewriteRule ^(tools|\.git)(/|$) - [F,L]
  RewriteRule ^(README\.md|netlify\.toml|\.gitignore)$ - [F,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  # Strony HTML zawsze świeże; CSS/JS mają ?v= w adresie, zdjęcia rzadko się zmieniają
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(css|js|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
  <FilesMatch "\.(webp|jpe?g|png|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>
